# Copy to .env and fill in. Never commit .env.

# Free key from https://api.nasa.gov, used in the browser for APOD (DEMO_KEY allows 30 requests/hour).
# Also read by `bun run fetch:fixtures` as NASA_API_KEY.
VITE_NASA_API_KEY="DEMO_KEY"
NASA_API_KEY="DEMO_KEY"

# Set to 1 to build a site that never calls NASA and always uses the offline fixtures.
# (At runtime you can also add ?offline=1 to the URL.)
VITE_OFFLINE="0"

# Port for the production server (server.js).
PORT="3000"
